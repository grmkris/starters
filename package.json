{
  "name": "agent-native-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@agent-native/web",
    "dev:server": "turbo run dev --filter=@agent-native/server",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "build": "turbo run build",
    "build:apps": "turbo run build --filter=!@agent-native/contracts",
    "check": "bun run format:check && bun run lint:types && bun run typecheck && bun run graph && bun run agents:check && bun run test && bun run knip",
    "check:fast": "bun run format:check && bun run lint && bun run typecheck",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "lint:types": "oxlint --type-aware --report-unused-disable-directives .",
    "typecheck": "turbo run typecheck --filter=!@agent-native/contracts && tsc --noEmit -p tools/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "turbo run test --filter=!@agent-native/contracts",
    "test:contracts": "forge test --root packages/contracts",
    "knip": "knip",
    "graph": "bun tools/check-graph.ts",
    "icons": "bun tools/icons.ts",
    "models:fixture": "bun tools/glb.ts",
    "agents:check": "bun tools/check-agent-files.ts",
    "hooks:install": "lefthook install",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@oxlint/plugins": "1.81.0",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "effect": "4.0.0-rc.112",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "ultracite": "7.10.8"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
