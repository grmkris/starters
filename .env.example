PORT=3001
# Optional. Set to record an ndjson ledger per run for `bun run --cwd apps/server replay`.
# LEDGER_DIR=.ledger
# Optional. The web port; two worktrees cannot both bind the default 3000.
# WEB_PORT=3000
# Optional. The client talks to the socket same-origin and the dev server
# proxies it, so this is only needed when the server is on another origin.
# VITE_WS_URL=ws://localhost:3001/realtime
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_native
ETHEREUM_RPC_URL=http://127.0.0.1:8545
